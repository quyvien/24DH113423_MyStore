@model _24DH113423_MyStore.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = Model.Product.ProductName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/myStyle/CustomerDetailProduct.css" />

<div class="page-shell product-detail-page">
    <nav class="breadcrumb-minimal" aria-label="Đường dẫn">
        <a href="@Url.Action("Index", "Home")">Sản phẩm</a>
        <i class="fas fa-chevron-right"></i>
        <span>@Model.Product.Category.CategoryName</span>
    </nav>

    <section class="product-detail-grid">
        <div class="product-gallery">
            <span class="detail-badge">Nổi bật</span>
            <img src="@Model.Product.ProductImage" alt="@Model.Product.ProductName" />
        </div>

        <div class="product-info">
            <span class="eyebrow">@Model.Product.Category.CategoryName</span>
            <h1>@Model.Product.ProductName</h1>
            <div class="detail-meta">
                <span><i class="fas fa-star"></i> Sản phẩm được yêu thích</span>
                <span>@Model.Product.OrderDetails.Count() đã bán</span>
            </div>
            <p class="pro-price">@Model.Product.ProductPrice.ToString("N0")₫</p>
            <div class="product-description">
                <h2>Thông tin sản phẩm</h2>
                <p>@Model.Product.ProductDescription</p>
            </div>
        </div>

        <aside class="buy-card">
            @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Get))
            {
                <input type="hidden" name="id" value="@Model.Product.ProductID" />
                <div class="buy-row">
                    <span>Đơn giá</span>
                    <strong>@Model.Product.ProductPrice.ToString("N0")₫</strong>
                </div>
                <label for="quantity">Số lượng</label>
                @Html.TextBoxFor(model => model.quantity, new { @class = "form-control quantity-input", @type = "number", @min = 1, id = "quantity" })
                <div class="buy-total">
                    <span>Tạm tính</span>
                    <strong>@Model.estimatedValue.ToString("N0")₫</strong>
                </div>
                <button type="submit" class="btn btn-primary add-to-cart">Thêm vào giỏ hàng</button>
                <p class="buy-note"><i class="fas fa-shield-alt"></i> Thanh toán an toàn · Hỗ trợ đổi trả</p>
            }
        </aside>
    </section>

    <section class="related-wrap">
        @Html.Partial("PVRelatedProduct", Model)
    </section>

    <section class="top-wrap">
        @Html.Partial("PVTopProduct", Model)
    </section>
</div>

