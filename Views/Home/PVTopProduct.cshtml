@model _24DH113423_MyStore.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <div class="detail-section-heading">
        <span class="eyebrow">Được chọn nhiều</span>
        <h2>Sản phẩm bán chạy</h2>
    </div>
    <div class="top-product-list">
        @foreach (var product in Model.TopProducts)
        {
            <article class="top-product">
                <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                    <img src="@product.ProductImage" alt="@product.ProductName" loading="lazy" />
                </a>
                <div>
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">@product.ProductName</a>
                    <strong>@product.ProductPrice.ToString("N0")₫</strong>
                </div>
            </article>
        }
    </div>
    <div class="pagination-container">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", new { id = Model.Product.ProductID, quantity = Model.quantity, page }))
    </div>
}

