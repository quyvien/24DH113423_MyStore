@model _24DH113423_MyStore.Models.ViewModel.HomeProductVM
@using PagedList.Mvc

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="product-section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Vừa cập nhật</span>
                <h2>Sản phẩm mới</h2>
            </div>
            <span class="section-note">Khám phá những món đồ mới nhất</span>
        </div>
        <div class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <article class="product-item">
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="product-image">
                        <img src="@product.ProductImage" alt="@product.ProductName" loading="lazy" />
                        <span class="product-arrow"><i class="fas fa-arrow-right"></i></span>
                    </a>
                    <div class="product-meta">
                        <span class="prodCate">@product.Category.CategoryName</span>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="prodName">@product.ProductName</a>
                        <span class="prodPrice">@product.ProductPrice.ToString("N0")₫</span>
                        <span class="prodSale">@product.OrderDetails.Count sản phẩm đã bán</span>
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="pagination-container">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm }))
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-search"></i>
        <h3>Chưa tìm thấy sản phẩm</h3>
        <p>Thử một từ khóa ngắn hơn hoặc xem lại toàn bộ danh mục.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Xem tất cả sản phẩm</a>
    </div>
}

