@model _24DH113423_MyStore.Models.ViewModel.ProductDetailsVM

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <div class="detail-section-heading">
        <span class="eyebrow">Có thể bạn sẽ thích</span>
        <h2>Sản phẩm tương tự</h2>
    </div>
    <div class="related-grid">
        @foreach (var product in Model.RelatedProducts)
        {
            <article class="mini-product">
                <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="mini-product-image">
                    <img src="@product.ProductImage" alt="@product.ProductName" loading="lazy" />
                </a>
                <div>
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">@product.ProductName</a>
                    <strong>@product.ProductPrice.ToString("N0")₫</strong>
                </div>
            </article>
        }
    </div>
}

