@model _24DH113423_MyStore.Models.ViewModel.Cart
@using PagedList.Mvc

@if (Model.SimilarProducts != null && Model.SimilarProducts.Any())
{
    <section class="product-section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Gợi ý dành cho bạn</span>
                <h2>Sản phẩm tương tự</h2>
            </div>
        </div>
        <div class="list-container">
            @foreach (var product in Model.SimilarProducts)
            {
                <article class="product-item">
                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="product-image">
                        <img src="@product.ProductImage" alt="@product.ProductName" loading="lazy" />
                    </a>
                    <div class="product-meta">
                        <span class="prodCate">@product.Category.CategoryName</span>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })" class="prodName">@product.ProductName</a>
                        <span class="prodPrice">@product.ProductPrice.ToString("N0")₫</span>
                        @Html.ActionLink("Thêm vào giỏ", "AddToCart", "Cart", new { id = product.ProductID }, new { @class = "mini-add-button" })
                    </div>
                </article>
            }
        </div>
    </section>
    <div class="pagination-container">
        @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", new { page }))
    </div>
}

