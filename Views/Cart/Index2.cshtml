@model _24DH113423_MyStore.Models.ViewModel.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/Content/myStyle/CustomerHome.css" />

<script>
    function cartUpdateQuantity(id, newQuantity) {
        if (newQuantity < 1) return;
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '@Url.Action("UpdateQuantity", "Cart")';
        var idInput = document.createElement('input');
        idInput.type = 'hidden'; idInput.name = 'id'; idInput.value = id;
        var quantityInput = document.createElement('input');
        quantityInput.type = 'hidden'; quantityInput.name = 'quantity'; quantityInput.value = newQuantity;
        form.appendChild(idInput); form.appendChild(quantityInput);
        document.body.appendChild(form); form.submit();
    }
</script>

<div class="page-shell cart-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Đơn hàng của bạn</span>
            <h1>Giỏ hàng</h1>
        </div>
        @if (Model != null && Model.Items != null && Model.Items.Any())
        {
            <a href="@Url.Action("ClearCart", "Cart")" class="clear-cart"><i class="far fa-trash-alt"></i> Xóa tất cả</a>
        }
    </div>

    @if (Model == null || Model.Items == null || !Model.Items.Any())
    {
        <div class="empty-state">
            <i class="fas fa-shopping-bag"></i>
            <h3>Giỏ hàng đang trống</h3>
            <p>Hãy chọn một sản phẩm bạn yêu thích để bắt đầu.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var categoryGroup in Model.GroupedItems)
                {
                    <section class="cart-group">
                        <div class="cart-group-title">
                            <span>@categoryGroup.Key</span>
                            <small>@categoryGroup.Count() sản phẩm</small>
                        </div>
                        @foreach (var item in categoryGroup)
                        {
                            <article class="cart-item">
                                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })" class="cart-item-image">
                                    <img src="@item.ProductImage" alt="@item.ProductName" />
                                </a>
                                <div class="cart-item-info">
                                    <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">@item.ProductName</a>
                                    <span>@item.UnitPrice.ToString("N0")₫ / sản phẩm</span>
                                </div>
                                <div class="quantity-control" aria-label="Số lượng">
                                    <button type="button" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity - 1)">−</button>
                                    <span>@item.Quantity</span>
                                    <button type="button" onclick="cartUpdateQuantity(@item.ProductID, @item.Quantity + 1)">+</button>
                                </div>
                                <strong class="cart-line-price">@item.TotalPrice.ToString("N0")₫</strong>
                                <a href="@Url.Action("RemoveFromCart", "Cart", new { id = item.ProductID })" class="remove-item" aria-label="Xóa @item.ProductName"><i class="fas fa-times"></i></a>
                            </article>
                        }
                    </section>
                }
            </div>

            <aside class="cart-summary">
                <h2>Tóm tắt đơn hàng</h2>
                <div><span>Tạm tính</span><strong>@Model.TotalValue().ToString("N0")₫</strong></div>
                <div><span>Vận chuyển</span><span>Miễn phí</span></div>
                <div class="summary-total"><span>Tổng cộng</span><strong>@Model.TotalValue().ToString("N0")₫</strong></div>
                @Html.ActionLink("Tiến hành thanh toán", "Index", "Payment", null, new { @class = "btn btn-primary checkout-button" })
                <a href="@Url.Action("Index", "Home")" class="continue-shopping"><i class="fas fa-arrow-left"></i> Tiếp tục mua sắm</a>
            </aside>
        </div>

        <div class="cart-similar">
            @Html.Partial("_PVSimilarProduct", Model)
        </div>
    }
</div>

