@* Lấy thông tin giỏ hàng *@
@{
    var cart = Session["Cart"] as _24DH113423_MyStore.Models.ViewModel.Cart;

    // Tạo đối tượng ViewModel dùng PersonalMenuVM và lưu trong ViewBag,
    // khởi tạo giá trị dựa trên thông tin tài khoản đăng nhập
    ViewBag.pmmodel = new _24DH113423_MyStore.Models.ViewModel.PersonalMenuVM();
    ViewBag.pmmodel.IsLoggedIn = User.Identity.IsAuthenticated;
    ViewBag.pmmodel.Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty;

    // Nếu giỏ hàng không rỗng thì gán số lượng mặt hàng trong giỏ cho CartCount
    if (cart != null && cart.Items.Any())
    {
        ViewBag.pmmodel.CartCount = cart.Items.Count();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - My_Store</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        /* Thanh freeship */
        .header-top {
            background-color: #8FE38C;
            text-align: center;
            padding: 6px 0;
            font-size: 14px;
            color: #106100;
        }

            .header-top .fs-italic {
                font-weight: 700;
                font-style: italic;
            }

            .header-top .fs-extra {
                color: #007bff;
            }

        /* Header chính: logo trái, menu phải */
        .header-main {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
            background-color: #ffffff;
        }

        /* Logo */
        .header-logo .logo-link {
            text-decoration: none;
        }

        .logo-text {
            font-weight: 800;
            font-size: 26px;
            letter-spacing: 2px;
            color: #333;
        }

        /* Nav phải */
        .header-nav {
            display: flex;
            align-items: center;
            gap: 25px;
            font-size: 14px;
        }

            /* Menu item */
            .header-nav .nav-item {
                display: flex;
                align-items: center;
                text-decoration: none;
                color: #333;
                position: relative;
            }

                /* Thêm icon vào menu */
                .header-nav .nav-item i {
                    margin-right: 5px;
                }

                .header-nav .nav-item:hover {
                    color: #007bff;
                }

        /* Dropdown tài khoản */
        .dropdown {
            position: relative;
        }

            .dropdown .nav-link {
                display: flex;
                align-items: center;
                text-decoration: none;
                color: #333;
            }

        .dropdown-arrow {
            margin-left: 4px;
            font-size: 10px;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: #fff;
            min-width: 180px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            z-index: 1000;
        }

            .dropdown-content a {
                display: block;
                padding: 8px 14px;
                color: #333;
                text-decoration: none;
                font-size: 13px;
            }

                .dropdown-content a:hover {
                    background-color: #f5f5f5;
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* Giỏ hàng */
        .cart-badge {
            background-color: #ff4d4f;
            color: #fff;
            border-radius: 999px;
            padding: 2px 7px;
            font-size: 11px;
            margin-left: 4px;
        }

        /* Thanh navbar */
        .header-nav .nav-item {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: #333;
            position: relative;
        }
    </style>
</head>
<body>
    <header>
        <!-- Thanh freeship màu xanh -->
        <div class="header-top">
            <p>
                Free ship đơn từ 40K, giảm nhiều hơn cùng
                <span class="fs-italic">FREESHIP</span><span class="fs-extra"> EXTRA</span>
            </p>
        </div>

        <!-- Header chính: logo trái, menu phải -->
        <div class="header-main container">
            <!-- Logo -->
            <div class="header-logo">
                <a href="@Url.Action("Index", "Home")" class="logo-link">
                    @* Có thể thay bằng <img> nếu bạn có file logo *@
                    <span class="logo-text">FASTOR</span>
                </a>
            </div>

            <!-- Menu phải -->
            <nav class="header-nav">
                <!-- Trang chủ -->
                <a href="@Url.Action("Index", "Home")" class="nav-item">
                    <i class="fas fa-home"></i>
                    <span>Trang chủ</span>
                </a>

                <!-- Tài khoản / Đăng nhập - Đăng ký -->
                <div class="nav-item dropdown">
                    <a href="javascript:void(0)" class="nav-link">
                        <i class="fas fa-user-circle"></i>
                        <span id="account-name">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <text>Tài khoản (@ViewBag.pmmodel.Username)</text>
                            }
                            else
                            {
                                <text>Tài khoản</text>
                            }
                        </span>
                        <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </a>

                    <div class="dropdown-content">
                        @if (ViewBag.pmmodel.IsLoggedIn)
                        {
                            <a href="@Url.Action("Profile", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("OrderHistory", "Order")">Lịch sử mua hàng</a>
                            <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                            <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                        }
                    </div>
                </div>

                <!-- Giỏ hàng -->
                <a href="@Url.Action("Index", "Cart")" class="nav-item">
                    <i class="fas fa-shopping-cart"></i>
                    <span>Giỏ hàng</span>
                    <span class="cart-badge" id="cart-count">@ViewBag.pmmodel.CartCount</span>
                </a>
            </nav>
        </div>
    </header>

    @* Nội dung chính của View sẽ được render ở đây *@
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>