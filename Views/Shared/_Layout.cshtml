@{
    var cart = Session["Cart"] as _24DH113423_MyStore.Models.ViewModel.Cart;
    ViewBag.pmmodel = new _24DH113423_MyStore.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = User.Identity.IsAuthenticated,
        Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty,
        CartCount = cart != null && cart.Items.Any() ? cart.Items.Count() : 0
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173f38" />
    <title>@ViewBag.Title - FASTOR</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
</head>
<body>
    <header class="site-header">
        <div class="announcement">
            <div class="site-shell announcement-inner">
                <span>Miễn phí vận chuyển cho đơn từ 400.000đ</span>
                <span class="announcement-note">Mua sắm nhẹ nhàng, giao hàng tận nơi.</span>
            </div>
        </div>

        <div class="site-shell header-main">
            <a href="@Url.Action("Index", "Home")" class="brand" aria-label="FASTOR - Trang chủ">
                <span class="brand-mark">F</span>
                <span>FASTOR</span>
            </a>

            <nav class="header-nav" aria-label="Điều hướng chính">
                <a href="@Url.Action("Index", "Home")" class="nav-link">Sản phẩm</a>
                <a href="@Url.Action("About", "Home")" class="nav-link nav-link-secondary">Về chúng tôi</a>
                <a href="@Url.Action("Contact", "Home")" class="nav-link nav-link-secondary">Liên hệ</a>

                <div class="account-menu">
                    <button type="button" class="icon-link account-trigger" aria-label="Tài khoản">
                        <i class="far fa-user" aria-hidden="true"></i>
                        <span class="account-label">@(ViewBag.pmmodel.IsLoggedIn ? ViewBag.pmmodel.Username : "Tài khoản")</span>
                        <i class="fas fa-chevron-down menu-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="account-dropdown">
                        @if (ViewBag.pmmodel.IsLoggedIn)
                        {
                            <a href="@Url.Action("Profile", "Account")">Thông tin tài khoản</a>
                            <a href="@Url.Action("OrderHistory", "Order")">Đơn hàng của tôi</a>
                            <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        }
                        else
                        {
                            <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                            <a href="@Url.Action("Register", "Account")">Tạo tài khoản</a>
                        }
                    </div>
                </div>

                <a href="@Url.Action("Index", "Cart")" class="icon-link cart-link" aria-label="Giỏ hàng có @ViewBag.pmmodel.CartCount sản phẩm">
                    <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                    <span class="cart-label">Giỏ hàng</span>
                    <span class="cart-badge" id="cart-count">@ViewBag.pmmodel.CartCount</span>
                </a>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-shell footer-grid">
            <div>
                <a href="@Url.Action("Index", "Home")" class="brand brand-footer">
                    <span class="brand-mark">F</span><span>FASTOR</span>
                </a>
                <p>Những sản phẩm thiết thực, được chọn lọc cho nhịp sống hiện đại.</p>
            </div>
            <div class="footer-links">
                <span>Khám phá</span>
                <a href="@Url.Action("Index", "Home")">Sản phẩm</a>
                <a href="@Url.Action("About", "Home")">Về FASTOR</a>
                <a href="@Url.Action("Contact", "Home")">Liên hệ</a>
            </div>
            <div class="footer-links">
                <span>Hỗ trợ</span>
                <a href="@Url.Action("Index", "Cart")">Giỏ hàng</a>
                <a href="@Url.Action("Login", "Account")">Tài khoản</a>
                <span class="footer-muted">T2–T7 · 08:00–20:00</span>
            </div>
        </div>
        <div class="site-shell footer-bottom">
            <span>© @DateTime.Now.Year FASTOR</span>
            <span>Thiết kế tối giản. Trải nghiệm rõ ràng.</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
