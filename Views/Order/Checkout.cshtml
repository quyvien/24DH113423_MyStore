@model _24DH113423_MyStore.Models.ViewModel.CheckoutVM
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    function enableAddressEdit() {
        document.getElementById("ShippingAddress").removeAttribute("readonly");
        document.getElementById("ShippingAddress").focus();
    }
</script>

<div class="page-shell checkout-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">Xác nhận thông tin</span>
            <h1>Đặt hàng</h1>
        </div>
    </div>

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "order-form" }))
    {
        @Html.AntiForgeryToken()
        <div class="checkout-layout">
            <div>
                <section class="checkout-card">
                    <div class="checkout-card-heading"><span>Sản phẩm</span><small>@Model.CartItems.Count sản phẩm</small></div>
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="checkout-product checkout-product-image">
                            <img src="@item.ProductImage" alt="@item.ProductName" />
                            <span>@item.ProductName <small>@item.Quantity × @item.UnitPrice.ToString("N0")₫</small></span>
                            <strong>@item.TotalPrice.ToString("N0")₫</strong>
                        </div>
                    }
                </section>

                <section class="checkout-card form-card">
                    <div class="checkout-card-heading"><span>Thông tin giao hàng</span></div>
                    <div class="form-group address-field">
                        @Html.LabelFor(m => m.ShippingAddress, new { @class = "control-label" })
                        @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control", @readonly = "readonly", id = "ShippingAddress" })
                        <button type="button" class="edit-address" onclick="enableAddressEdit()">Chỉnh sửa</button>
                        @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger" })
                    </div>

                    <div class="option-group">
                        <span class="control-label">Phương thức giao hàng</span>
                        <label class="option-card">@Html.RadioButtonFor(m => m.ShippingMethod, "Giao nhanh") <span><strong>Giao nhanh</strong><small>Nhận hàng sớm nhất</small></span></label>
                        <label class="option-card">@Html.RadioButtonFor(m => m.ShippingMethod, "Giao tiết kiệm") <span><strong>Giao tiết kiệm</strong><small>Tối ưu chi phí vận chuyển</small></span></label>
                        @Html.ValidationMessageFor(m => m.ShippingMethod, "", new { @class = "text-danger" })
                    </div>

                    <div class="option-group">
                        <span class="control-label">Phương thức thanh toán</span>
                        <label class="option-card">@Html.RadioButtonFor(m => m.PaymentMethod, "Tiền mặt") <span><strong>Tiền mặt</strong><small>Thanh toán khi nhận hàng</small></span></label>
                        <label class="option-card">@Html.RadioButtonFor(m => m.PaymentMethod, "PayPal") <span><strong>PayPal</strong><small>Thanh toán trực tuyến</small></span></label>
                        <label class="option-card">@Html.RadioButtonFor(m => m.PaymentMethod, "Mua trước trả sau") <span><strong>Mua trước, trả sau</strong><small>Linh hoạt kế hoạch chi tiêu</small></span></label>
                        @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
                    </div>
                </section>
            </div>

            <aside class="payment-summary">
                <span class="eyebrow">Tổng thanh toán</span>
                <strong>@Model.TotalAmount.ToString("N0")₫</strong>
                @Html.HiddenFor(m => m.TotalAmount)
                @Html.HiddenFor(m => m.OrderDate)
                <p>Kiểm tra kỹ thông tin trước khi hoàn tất đơn hàng.</p>
                <button type="submit" class="btn btn-primary">Hoàn tất đặt hàng</button>
                <a href="@Url.Action("Index2", "Cart")">Quay lại giỏ hàng</a>
            </aside>
        </div>
    }
</div>

