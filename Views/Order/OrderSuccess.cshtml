@model _24DH113423_MyStore.Models.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-shell">
    <section class="success-card">
        <div class="success-icon"><i class="fas fa-check"></i></div>
        <span class="eyebrow">Đơn hàng #@Model.OrderID</span>
        <h1>Cảm ơn bạn đã đặt hàng.</h1>
        <p>FASTOR đã tiếp nhận đơn hàng và sẽ cập nhật trạng thái trong thời gian sớm nhất.</p>
        <div class="order-facts">
            <div><span>Ngày đặt</span><strong>@Model.OrderDate.ToString("dd/MM/yyyy")</strong></div>
            <div><span>Tổng thanh toán</span><strong>@Model.TotalAmount.ToString("N0")₫</strong></div>
            <div><span>Trạng thái</span><strong>@Model.PaymentStatus</strong></div>
        </div>
        <div class="table-responsive order-detail-table">
            <table class="table">
                <thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>@item.Product.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0")₫</td>
                            <td>@item.TotalPrice.ToString("N0")₫</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary success-action">Tiếp tục mua sắm</a>
    </section>
</div>

