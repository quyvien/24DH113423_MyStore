@{
    var controller = ViewContext.RouteData.Values["controller"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#173f38" />
    <title>@ViewBag.Title - FASTOR Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="~/Content/myStyle/admin_layout.css" rel="stylesheet" />
</head>
<body>
    <aside class="sidebar">
        <a href="@Url.Action("trangchu2", "Home", new { area = "Admin" })" class="admin-brand">
            <span>F</span><strong>FASTOR</strong>
        </a>
        <span class="workspace-label">Không gian quản trị</span>

        <nav class="admin-nav">
            <a class="admin-nav-link @(controller == "Home" ? "active" : "")" href="@Url.Action("trangchu2", "Home", new { area = "Admin" })">
                <i class="bi bi-grid"></i><span>Tổng quan</span>
            </a>

            <span class="nav-section">Vận hành</span>
            <a class="admin-nav-link @(controller == "Orders" ? "active" : "")" href="@Url.Action("Index", "Orders", new { area = "Admin" })">
                <i class="bi bi-receipt"></i><span>Đơn hàng</span>
            </a>
            <a class="admin-nav-link @(controller == "Products" ? "active" : "")" href="@Url.Action("Index", "Products", new { area = "Admin" })">
                <i class="bi bi-box-seam"></i><span>Sản phẩm</span>
            </a>
            <a class="admin-nav-link @(controller == "Categories" ? "active" : "")" href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                <i class="bi bi-tags"></i><span>Danh mục</span>
            </a>

            <span class="nav-section">Khách hàng</span>
            <a class="admin-nav-link @(controller == "Customers" ? "active" : "")" href="@Url.Action("Index", "Customers", new { area = "Admin" })">
                <i class="bi bi-people"></i><span>Khách hàng</span>
            </a>
            <a class="admin-nav-link @(controller == "Users" ? "active" : "")" href="@Url.Action("Index", "Users", new { area = "Admin" })">
                <i class="bi bi-person-gear"></i><span>Tài khoản</span>
            </a>
        </nav>

        <a class="admin-exit" href="@Url.Action("Index", "Home", new { area = "" })">
            <i class="bi bi-arrow-left"></i><span>Về cửa hàng</span>
        </a>
    </aside>

    <div class="main-content">
        <header class="admin-header">
            <div>
                <span class="header-kicker">FASTOR ADMIN</span>
                <h1>@ViewBag.Title</h1>
            </div>
            <div class="admin-user">
                <span class="admin-avatar">A</span>
                <div><strong>Admin</strong><small>Quản trị viên</small></div>
            </div>
        </header>
        <main class="content-area">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

