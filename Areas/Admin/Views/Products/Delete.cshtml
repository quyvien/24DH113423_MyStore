@model _24DH113423_MyStore.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA SẢN PHẨM</h2>

<h4 class="alert-danger">Bạn thực sự muốn xóa sản phẩm này à?</h4>

@Html.Partial("PVProductInfo", Model)

@using (Html.BeginForm("Delete", "Products", new { id = Model.ProductID }, FormMethod.Post))
{
    @Html.AntiForgeryToken() <!-- CSRF Token -->
    <div class="form-group">
        <div class="col-md-offset-3 col-md-9">
            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
            <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-sm">Quay lại danh sách</a>
        </div>
    </div>
}