@{
    ViewBag.Title = "Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<section class="admin-welcome">
    <span>FASTOR WORKSPACE</span>
    <h2>Mọi thứ bạn cần,<br />trong một không gian.</h2>
    <p>Quản lý cửa hàng rõ ràng và tập trung hơn.</p>
</section>

<section class="quick-grid">
    <a href="@Url.Action("Index", "Orders")" class="quick-card">
        <i class="bi bi-receipt"></i>
        <span>Vận hành</span>
        <strong>Quản lý đơn hàng</strong>
        <small>Theo dõi và cập nhật đơn hàng <i class="bi bi-arrow-right"></i></small>
    </a>
    <a href="@Url.Action("Index", "Products")" class="quick-card">
        <i class="bi bi-box-seam"></i>
        <span>Kho hàng</span>
        <strong>Quản lý sản phẩm</strong>
        <small>Cập nhật danh mục sản phẩm <i class="bi bi-arrow-right"></i></small>
    </a>
    <a href="@Url.Action("Index", "Customers")" class="quick-card">
        <i class="bi bi-people"></i>
        <span>Khách hàng</span>
        <strong>Quản lý khách hàng</strong>
        <small>Xem thông tin khách hàng <i class="bi bi-arrow-right"></i></small>
    </a>
</section>

